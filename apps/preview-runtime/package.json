{
  "name": "@nexo/preview-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --clean",
    "clean": "rimraf dist coverage",
    "lint": "eslint src test",
    "start": "node --max-old-space-size=384 dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/throttler": "6.5.0",
    "@nexo/api": "workspace:*",
    "@nexo/cache": "workspace:*",
    "@nexo/config": "workspace:*",
    "@nexo/database": "workspace:*",
    "@nexo/identity": "workspace:*",
    "@nexo/inbox": "workspace:*",
    "@nexo/observability": "workspace:*",
    "@nexo/organization": "workspace:*",
    "@nexo/platform": "workspace:*",
    "@nexo/shared": "workspace:*",
    "@nexo/webhook-gateway": "workspace:*",
    "@nexo/worker": "workspace:*",
    "@nexo/whatsapp": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.5",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "rimraf": "6.0.1",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
