{
  "name": "@nexo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --clean",
    "clean": "rimraf dist coverage",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "6.5.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@nexo/auth": "workspace:*",
    "@nexo/cache": "workspace:*",
    "@nexo/config": "workspace:*",
    "@nexo/database": "workspace:*",
    "@nexo/identity": "workspace:*",
    "@nexo/notification": "workspace:*",
    "@nexo/observability": "workspace:*",
    "@nexo/organization": "workspace:*",
    "@nexo/platform": "workspace:*",
    "@nexo/shared": "workspace:*",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "rimraf": "6.0.1",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
