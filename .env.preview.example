# Preview only: do not reuse these resources or keys in production.
APP_ENV=preview
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nexo_preview?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
AUTH_JWT_PRIVATE_KEY=-----BEGIN_PRIVATE_KEY-----\\nPREVIEW_ONLY\\n-----END_PRIVATE_KEY-----
AUTH_JWT_PUBLIC_KEY=-----BEGIN_PUBLIC_KEY-----\\nPREVIEW_ONLY\\n-----END_PUBLIC_KEY-----
AUTH_JWT_ISSUER=nexo-preview
AUTH_JWT_AUDIENCE=nexo-preview-api
AUTH_EMAIL_VERIFICATION_REQUIRED=false
PREVIEW_MAILBOX_ACCESS_KEY=replace-with-at-least-32-random-characters
WEB_ORIGIN=https://preview.example.invalid
NEXT_PUBLIC_API_URL=https://api.preview.example.invalid
OTEL_EXPORTER_OTLP_ENDPOINT=
# Storage stays disabled until its adapter is explicitly enabled.
STORAGE_PROVIDER=s3-compatible

# Meta WhatsApp (store values in Preview secret managers only)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ORGANIZATION_ID=
META_WHATSAPP_INBOX_NAME=WhatsApp
