NODE_ENV=development
LOG_LEVEL=info
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002
WEBHOOK_GATEWAY_PORT=3003
# Development/sandbox credentials only. Never reuse production resources here.
DATABASE_URL=postgresql://SANDBOX_USER:SANDBOX_PASSWORD@SANDBOX_HOST:5432/nexo_dev?sslmode=require
REDIS_URL=rediss://default:SANDBOX_TOKEN@SANDBOX_REDIS_HOST:6379
# Integration tests require separate disposable resources and never fall back to DATABASE_URL/REDIS_URL.
TEST_DATABASE_URL=
TEST_REDIS_URL=
STORAGE_PROVIDER=s3-compatible
STORAGE_ENDPOINT=https://SANDBOX_STORAGE_ENDPOINT
STORAGE_REGION=auto
STORAGE_BUCKET=nexo-development
STORAGE_ACCESS_KEY_ID=SANDBOX_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=SANDBOX_SECRET_KEY
OTEL_EXPORTER_OTLP_ENDPOINT=
# Generate a dedicated Ed25519 key pair per environment. Use escaped newlines in hosted secrets.
# Non-production execution generates an ephemeral key only when these are empty.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=nexo
AUTH_JWT_AUDIENCE=nexo-api
# Temporary development/preview convenience. Keep true in production.
AUTH_EMAIL_VERIFICATION_REQUIRED=false
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
NEXT_PUBLIC_API_URL=http://localhost:3001
OPENAPI_ENABLED=true
# Meta (WhatsApp Cloud API + Instagram Messaging)
# Obtain from developers.facebook.com > Your App > App Settings > Basic.
# META_APP_ID and META_APP_SECRET are shared across WhatsApp and Instagram products.
# META_WEBHOOK_VERIFY_TOKEN is a random string you choose and must also be set in Meta's webhook config.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Cloud API — from Meta > WhatsApp > API Setup.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Instagram Messaging — from Meta > Instagram > API Setup (requires Business/Creator account + App Review).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
