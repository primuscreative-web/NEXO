{
  "name": "nexo",
  "version": "0.0.0",
  "private": true,
  "description": "NEXO enterprise SaaS platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node tooling/scripts/clean-root.mjs",
    "dev": "turbo run dev --parallel",
    "docker:optional:config": "docker compose config --quiet",
    "docker:optional:down": "docker compose down --remove-orphans",
    "docker:optional:up": "docker compose up -d postgres redis",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm --filter @nexo/database prisma:generate",
    "prisma:migrate": "pnpm --filter @nexo/database prisma:migrate",
    "prisma:validate": "pnpm --filter @nexo/database prisma:validate",
    "security:audit": "pnpm audit --audit-level high",
    "bundle:check": "node tooling/scripts/check-web-bundle.mjs",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:components": "turbo run test:components",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "turbo run test:unit",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:coverage && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.55.1",
    "@swc/core": "1.15.43",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "ioredis": "5.11.1",
    "pg": "8.22.0",
    "prettier": "3.6.2",
    "turbo": "2.9.14",
    "typescript": "7.0.2",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.45.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.3"
  }
}
