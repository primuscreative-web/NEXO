{
  "name": "nexo",
  "version": "0.0.0",
  "private": true,
  "description": "NEXO enterprise SaaS platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node tooling/scripts/clean-root.mjs",
    "dev": "turbo run dev --parallel",
    "docker:optional:config": "docker compose config --quiet",
    "docker:optional:down": "docker compose down --remove-orphans",
    "docker:optional:up": "docker compose up -d postgres redis",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm --filter @nexo/database prisma:generate",
    "prisma:migrate": "pnpm --filter @nexo/database prisma:migrate",
    "prisma:validate": "pnpm --filter @nexo/database prisma:validate",
    "security:audit": "pnpm audit --audit-level high",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:coverage && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@swc/core": "1.15.43",
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "ioredis": "5.8.2",
    "pg": "8.16.3",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.3"
  }
}
